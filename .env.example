# Copy this file to `.env.local` and fill in any keys you want to use.
# The app works fully without any keys (mock mode is the default).

NEXT_PUBLIC_APP_NAME="Oral Cancer Agentic AI Screening Prototype"

# Default vision provider when the user does not pick one in the UI.
# Allowed: mock | gemini | claude | local
VISION_PROVIDER=mock

# Optional — Gemini Vision (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Strongest current Flash model with built-in thinking
GEMINI_MODEL=gemini-3.5-flash
# Multi-Expert Panel (Epidemiologist + General Dentist) text-only model
GEMINI_EXPERT_MODEL=gemini-3.5-flash
# Patient Chat Agent — speed matters
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Optional — Claude Vision (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7
# The Oral Pathologist expert defaults to Claude for deeper reasoning
EXPERT_PATHOLOGIST_PROVIDER=claude
EXPERT_PATHOLOGIST_MODEL=claude-opus-4-7

# Optional — Future custom model FastAPI server
LOCAL_MODEL_ENDPOINT=

# Network timeout for vision provider calls (milliseconds)
VISION_API_TIMEOUT_MS=30000

# Optional — Telegram Bot (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_PROVIDER=gemini
# Webhook (production on Vercel). Secret protects the endpoint; base url is your deployment.
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# ── Auth (multi-user mode) ───────────────────────────────────────────────────
# Secret used to sign session cookies. CHANGE THIS in production (any long random string).
AUTH_SECRET=change-me-to-a-long-random-string
# Optional overrides for the three seeded demo accounts (defaults shown).
SEED_PATIENT1_PASSWORD=patient1
SEED_PATIENT2_PASSWORD=patient2
SEED_DOCTOR_PASSWORD=doctor

# ── Shared storage (Vercel KV / Upstash Redis) ───────────────────────────────
# Add the "KV" or "Upstash Redis" integration in the Vercel dashboard — it
# injects these automatically. Without them the app uses an in-memory store
# (fine for local dev; data is NOT shared across devices).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (Upstash naming also accepted:)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
